{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "git add . && git commit -m 'Deploy: Auto publish content 🚀' && git push origin doc-page",
    "server": "hexo server",
    "publish": "node scripts/publish.js",
    "publish:preview": "node scripts/publish.js --preview",
    "preview:stop": "node scripts/stop-preview.js",
    "preview": "hexo clean && hexo generate && hexo server",
    "cc-setup": "echo 'To use Claude Code shortcuts, run: source tools/cc-shortcuts.sh' && echo 'Available commands: ccd (claude --dangerously-skip-permissions + original config + 64000 tokens)'"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "pdfjs-dist": "^3.11.174",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-theme-next": "^8.24.1"
  }
}
