# 基础配置 - 自动检测文本文件并规范化行尾符
* text=auto

# Python 项目文件 - 统一使用 LF
*.py      text eol=lf
*.pyi     text eol=lf
*.pyx     text eol=lf

# 配置文件 - 使用 LF
*.toml    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.env     text eol=lf
*.lock    text eol=lf

# 文档文件 - 使用 LF
*.md      text eol=lf
*.txt     text eol=lf
*.rst     text eol=lf

# 数据交换格式 - 使用 LF
*.json    text eol=lf
*.jsonl   text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.csv     text eol=lf

# Web 相关文件 - 使用 LF
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf

# Shell 脚本 - 必须使用 LF（Linux/Mac 执行要求）
*.sh      text eol=lf
*.bash    text eol=lf
*.zsh     text eol=lf

# Docker 相关文件 - 使用 LF
Dockerfile*     text eol=lf
*.dockerfile    text eol=lf
docker-compose* text eol=lf

# Windows 批处理文件 - 使用 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# SQL 文件 - 使用 LF
*.sql     text eol=lf

# 日志文件 - 使用 LF
*.log     text eol=lf

# 二进制文件 - 不做行尾符转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.tar     binary
*.gz      binary
*.tgz     binary
*.7z      binary
*.exe     binary
*.dll     binary
*.so      binary
*.dylib   binary
*.whl     binary
*.egg     binary

# Python 字节码和缓存 - 标记为二进制
*.pyc     binary
*.pyo     binary
*.pyd     binary

# Excel 和其他办公文件 - 二进制
*.xlsx    binary
*.xls     binary
*.doc     binary
*.docx    binary
